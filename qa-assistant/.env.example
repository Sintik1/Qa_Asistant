# Base URL of the QA Assistant Flask API
# macOS often reserves :5000 for AirTunes — prefer 5001 for Flask locally
VITE_API_BASE_URL=http://127.0.0.1:5001

# Supabase Auth (publishable only — never put service_role here)
VITE_SUPABASE_URL=https://revyywfeeqdmlgrbakpj.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Yandex Metrika — public counter id only (not a secret). Leave empty to disable.
# Create counter: https://metrika.yandex.ru/ → Settings → Counter code
VITE_YANDEX_METRIKA_ID=
