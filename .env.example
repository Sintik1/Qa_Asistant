# Supabase (project_ref=revyywfeeqdmlgrbakpj)
SUPABASE_URL=https://revyywfeeqdmlgrbakpj.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Server-only — never expose to the browser / commit real value
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# JWT secret from Dashboard → Settings → API (HS256 verify). Prefer over Auth API round-trip.
SUPABASE_JWT_SECRET=your_jwt_secret
# Persistence: auto (Supabase if URL/keys present) | supabase | memory
PERSIST_BACKEND=auto

# ---------------------------------------------------------------------------
# OAuth2 (Google + Yandex) — SERVER ONLY. Never commit real values. Never VITE_*.
# Save via: python3 scripts/save_oauth_secrets.py
# Full guide: docs/OAUTH_SETUP.md
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
OAUTH_PUBLIC_APP_URL=http://127.0.0.1:5173
OAUTH_API_PUBLIC_URL=http://127.0.0.1:5001

# ---------------------------------------------------------------------------
# AI provider: ollama (local study/debug) | leopold (TZ / production)
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama

# --- Ollama + Qwen ---
# MacBook Air M1 8GB → qwen2.5:1.5b (рекомендуется). 3b — опционально.
# 7b/14b на 8GB не ставить (swap / OOM).
# macOS 13 (Ventura): нужен Ollama ≤0.6.x (см. scripts/setup_ollama.sh)
AI_OLLAMA_SIZE=1.5b
QA_ASISTANT_API_URL=http://localhost:11434/v1/chat/completions
QA_ASISTANT_API_TOKEN=ollama
QA_ASISTANT_MODEL=qwen2.5:1.5b
# QA_ASISTANT_MODEL=qwen2.5:3b

# --- Leopold (ТЗ) ---
# AI_PROVIDER=leopold
# QA_ASISTANT_API_URL=https://your-leopold-endpoint
# QA_ASISTANT_API_TOKEN=your_leopold_token
# QA_ASISTANT_MODEL=Qwen/Qwen2.5-72B-Instruct

AI_TIMEOUT_SEC=300

# Flask
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
FLASK_APP=wsgi:app
# AUTH_DEV_BYPASS=1  — ONLY local laptop debug without JWT.
# FORBIDDEN on any public host (Railway/Render/Fly/Vercel/Heroku) and when
# FLASK_ENV|ENV|APP_ENV=production or PUBLIC_DEPLOY=1 — code ignores the flag there.
# AUTH_DEV_BYPASS=1
# PUBLIC_DEPLOY=1
# FLASK_ENV=production

# Document upload / extract (Supabase Storage bucket `documents`, else local uploads/)
UPLOADS_DIR=uploads
SUPABASE_DOCUMENTS_BUCKET=documents

# Logging (self-hosted Flask) — JSON lines → logs/app.log + stdout
# Guide: docs/LOGGING.md
LOG_LEVEL=INFO
LOG_JSON=1
LOG_TO_FILE=1
LOG_DIR=logs
LOG_FILE=app.log
LOG_SERVICE=qa-assistant
APP_ENV=development
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
# AI log analysis: POST /api/admin/analyze-logs + tools/analyze_logs.py
# Scenarios: general|auth|cors|ai|persist (--scenario / body.scenario)
LOG_ANALYZE_ENABLED=1
# Required outside pytest (header X-Admin-Token). Empty → 403 in non-testing.
LOG_ANALYZE_ADMIN_TOKEN=change-me-local-admin

# Chunk defaults
CHUNK_SIZE=4000
CHUNK_OVERLAP=200
CHUNK_METHOD=header

# ---------------------------------------------------------------------------
# RAG embeddings (pgvector document_chunks / case_chunks)
# EMBEDDING_PROVIDER: auto | ollama | openai_compat | hash
# hash = deterministic offline (tests / no model); not semantic-quality
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
# Ollama default: http://localhost:11434/api/embeddings
# OpenAI-compat: https://api.openai.com/v1/embeddings + EMBEDDING_API_TOKEN
# EMBEDDING_API_URL=
# EMBEDDING_API_TOKEN=
EMBEDDING_TIMEOUT_SEC=60

# Frontend (Vite)
VITE_SUPABASE_URL=https://revyywfeeqdmlgrbakpj.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# macOS: port 5000 may be AirTunes — use 5001 for local Flask
VITE_API_BASE_URL=http://127.0.0.1:5001
